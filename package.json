{
  "name": "account-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:dev": "tauri android dev --host 127.0.0.1",
    "android:build:arm64:release:installable": "tauri android build --target aarch64 && node ./scripts/android-sign-apk.mjs --input src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release-unsigned.apk --output src-tauri/gen/android/artifacts/apk/release/app-arm64-v8a-release-debugSigned.apk",
    "android:build:armv7:release:installable": "tauri android build --target armv7 && node ./scripts/android-sign-apk.mjs --input src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release-unsigned.apk --output src-tauri/gen/android/artifacts/apk/release/app-armeabi-v7a-release-debugSigned.apk",
    "android:build:x86:release:installable": "tauri android build --target i686 && node ./scripts/android-sign-apk.mjs --input src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release-unsigned.apk --output src-tauri/gen/android/artifacts/apk/release/app-x86-release-debugSigned.apk",
    "android:build:x86_64:release:installable": "tauri android build --target x86_64 && node ./scripts/android-sign-apk.mjs --input src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release-unsigned.apk --output src-tauri/gen/android/artifacts/apk/release/app-x86_64-release-debugSigned.apk",
    "android:build:all:release:installable": "pnpm run android:build:arm64:release:installable && pnpm run android:build:armv7:release:installable && pnpm run android:build:x86:release:installable && pnpm run android:build:x86_64:release:installable",
    "android:build:universal": "tauri android build",
    "android:build:aab": "tauri android build --target aarch64 --aab"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-http": "^2.5.4",
    "@tauri-apps/plugin-log": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.2.0",
    "@tauri-apps/plugin-sql": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.2.0",
    "@tauri-apps/plugin-window-state": "^2.2.0",
    "tauri-plugin-safe-area-insets": "^0.1.0",
    "@vant/auto-import-resolver": "^1.3.0",
    "echarts": "^6.0.0",
    "material-symbols": "^0.40.0",
    "naive-ui": "^2.43.2",
    "pinia": "^3.0.4",
    "unplugin-vue-components": "^30.0.0",
    "vant": "^4.9.21",
    "vue": "^3.5.13",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "internal-ip": "^8.0.1",
    "terser": "^5.37.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
