{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "os:allow-platform",
    "os:allow-version",
    "os:allow-os-type",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "log:allow-log"
  ]
}
