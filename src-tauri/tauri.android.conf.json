{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QINGJI",
  "version": "1.0.0",
  "identifier": "com.zzh.qingji",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "mobile-main",
        "url": "/mobile",
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "android": {
      "minSdkVersion": 26
    }
  }
}
